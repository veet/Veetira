# Copy to .env.local and fill in.

# --- Admin (/admin) ---
ADMIN_PASSWORD=choose-a-long-password
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Database ---
# SQLite file path (default: data/app.db)
DATABASE_PATH=data/app.db

# --- Email alerts via Resend (optional; without these, emails are logged to the console) ---
RESEND_API_KEY=
# Where booking / signup alerts are sent (comma-separate several)
NOTIFY_EMAIL=
# Sender; must be on a domain you verified in Resend. Defaults to onboarding@resend.dev for testing.
EMAIL_FROM=
